{
  "expo": {
    "name": "AngoTour",
    "slug": "angotour-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "angotour",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ao.angotour.mobile"
    },
    "android": {
      "package": "ao.angotour.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-video",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "A AngoTour precisa da tua localizacao para encontrar motoristas proximos e calcular a tua viagem.",
          "locationWhenInUsePermission": "A AngoTour precisa da tua localizacao para encontrar motoristas proximos e calcular a tua viagem."
        }
      ],
      "expo-notifications",
      "expo-splash-screen",
      "expo-status-bar"
    ]
  }
}
